# Backend service
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# ClickHouse placeholder for future semantic/query execution work
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Superset REST/MCP defaults
SUPERSET_BASE_URL=http://127.0.0.1:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=your_superset_password
SUPERSET_AUTH_PROVIDER=db

# Superset local Python/runtime paths
SUPERSET_PYTHON=D:\superset\.venv\Scripts\python.exe
SUPERSET_CONFIG_PATH=D:\superset\superset_config.py
SUPERSET_VENDOR_PYTHONPATH=E:\dev_apps\ai-bi-mvp\vendor_py
SUPERSET_DEMO_CHART_SCRIPT=E:\dev_apps\ai-bi-mvp\tools\create_superset_demo_charts.py

# Hermes integration
HERMES_HOME=E:\dev_apps\ai-bi-mvp\.hermes-runtime
HERMES_ENV_PATH=C:\Users\Zhang Linruo\.hermes\.env
HERMES_AGENT_ROOT=D:\openclaw\workspace\hermes-agent\hermes-agent-main
HERMES_PYTHON=D:\openclaw\workspace\hermes-agent\hermes-agent-main\venv\Scripts\python.exe
HERMES_TIMEOUT_SECONDS=600
USE_HERMES_FOR_DASHBOARDS=true
